{
  "name": "kaler-core",
  "private": true,
  "scripts": {
    "dev:api": "pnpm --filter @kaler/api dev",
    "dev:mobile": "pnpm --filter @kaler/mobile dev",
    "build": "pnpm --filter @kaler/shared build && pnpm --filter @kaler/api build && pnpm --filter @kaler/mobile build",
    "build:shared": "pnpm --filter @kaler/shared build",
    "build:api": "pnpm --filter @kaler/shared build && pnpm --filter @kaler/api build",
    "build:mobile": "pnpm --filter @kaler/shared build && pnpm --filter @kaler/mobile build",
    "serve": "pnpm --filter @kaler/api serve & pnpm --filter @kaler/mobile serve",
    "test": "pnpm -r run test --if-present",
    "lint": "pnpm -r run lint --if-present",
    "db:generate": "pnpm --filter @kaler/api db:generate",
    "db:migrate": "pnpm --filter @kaler/api db:migrate",
    "db:seed": "pnpm --filter @kaler/api db:seed"
  },
  "engines": {
    "node": ">=18"
  }
}
