{
  "expo": {
    "name": "KALER Emergency",
    "slug": "kaler-emergency",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "kaler",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#1E3A5F",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kaler.emergency",
      "config": {
        "googleMapsApiKey": "YOUR_API_KEY"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "KALER needs your location for zone-based emergency alerts and personnel tracking.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "KALER tracks your location to ensure your safety during emergencies, even when the app is in the background.",
        "UIBackgroundModes": ["location", "fetch"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1E3A5F"
      },
      "package": "com.kaler.emergency",
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_API_KEY"
        }
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "KALER tracks your location to ensure your safety during emergencies.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "expo-secure-store",
      "expo-haptics"
    ]
  }
}
